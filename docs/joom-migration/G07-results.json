  "implementation": {
    "J08": "Borrow plain Arrow Binary/LargeBinary byte spans only while copying into owned UnsafeRows; keep dictionary/fixed/nested/mixed-vector fallback and both upstream direct converters.",
    "J09": "Bounded schema/config-keyed projection-instance pool above upstream generated-class cache. Register completion before exposing a lazy iterator; never pool a late acquisition or an oversized retained buffer.",
    "J10": "Reuse unique insertion-ordered non-NULL dictionary values when falling back to plain String/Binary; reject repeated/reordered/unused/NULL dictionary values and preserve reference ownership.",
    "J11": "Owner-thread-only idle writer spill callback, busy/closed/reentrancy guards; allocation-free portable reset and pointer restoration before pending-row copy; terminal poison after any failed spill, detached callback and partial-file cleanup.",
    "J12": "Shared row/byte/nested-offset coalescer for local JVM and native direct readers; stable IPC/header widths, JNI bounds and export-count guards, signed-Int row ceiling, exact EOF/lifetime handling. Restore all-row/slice-aware Bloom merge required by multirow partial states.",
    "J13": "Gather only referenced batches on row-indexed native writer chunks; preserve run/round-robin paths and align compatible nested metadata/types without changing values.",
    "J21": "Keep upstream earlier sliced-broadcast offset normalization; restore old regressions and add raw binary/nested/AQE/reused-exchange coverage.",
    "J23": "Serialize ShuffleScan at initial planning as well as current AQE stage refresh; retain protobuf-driven JVM dispatch, reuse and DPP handling.",
    "J24": "Keep upstream effective JVM batch cap and session-conf capture. Restore small-positive512 check and exercise effective1/17 limits through actual sorted writers.",
    "J25": "Disable ordinary C2R codegen over direct/reused/staged Comet broadcast; preserve native C2R guards. Current skew/broadcast regressions pass; original cost-model toggle matrix belongs to G09 once that implementation exists.",
    "J26": "Opt-in >=16MiB shared-buffer-aware native decode/FFI logging; disabled mode does not sample registry/memory counters.",
    "J27": "Restore default-Kryo tests, including actual CometBroadcastValue payload wrapper. Final shaded Linux release-JAR qualification remains required."
  },
